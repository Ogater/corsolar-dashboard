# В локальной разработке запросы /api идут через Vite-прокси, чтобы не упираться в CORS.
VITE_API_BASE_URL=
API_PROXY_TARGET=https://dev.monitoring.cor-int.com

# На production либо проксируйте /api на этот же сервер, либо включите CORS
# на бэкенде и укажите его публичный адрес в VITE_API_BASE_URL.
